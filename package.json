{
  "name": "@leiboss/dsh-wiring",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Wire shipped-but-unmounted DeepSeek Harness capabilities and explain what is missing.",
  "exports": {
    ".": "./src/index.js",
    "./rule": "./src/rule.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["src", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "docs", "CHANGELOG.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "engines": { "dsh": ">=0.2.2-rc.1 <0.3.0-0" },
  "dependencies": {
    "@deepseek-ai/dsh-browser-use": "0.2.2-rc.1",
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "0.2.2-rc.1",
    "@deepseek-ai/dsh-lsp": "0.2.2-rc.1",
    "@deepseek-ai/dsh-lsp-stdio": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-lsp": "0.2.2-rc.1",
    "@deepseek-ai/dsh-webhook": "0.2.2-rc.1",
    "@deepseek-ai/dsh-webhook-github": "0.2.2-rc.1"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/leiboss/dsh-wiring.git" },
  "homepage": "https://github.com/leiboss/dsh-wiring#readme",
  "bugs": { "url": "https://github.com/leiboss/dsh-wiring/issues" },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "lsp",
    "language-server",
    "browser-use",
    "webhook",
    "github-webhook",
    "diagnostics"
  ],
  "publishConfig": { "access": "public" },
  "scripts": { "prepack": "node scripts/check.mjs" }
}
