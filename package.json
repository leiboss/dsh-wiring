{
  "name": "@local/dsh-wiring",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Wire shipped-but-unmounted DeepSeek Harness capabilities and explain what is missing.",
  "exports": {
    ".": "./src/index.js",
    "./rule": "./src/rule.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
